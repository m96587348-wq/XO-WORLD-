# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Client-safe public keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Server-Only Secret (NEVER prefix with VITE_ or expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Server Session Signing Secret (optional; ephemeral random secret generated in memory if unset)
SESSION_SECRET=
